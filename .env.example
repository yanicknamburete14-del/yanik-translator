# ============================================================================
# COFRE DO SERVIDOR - YANIK, TRANSLATOR (VARIÁVEIS DE AMBIENTE SEGURAS)
# Copie este arquivo para .env no servidor ou configure no painel do Render.
# NUNCA coloque chaves reais diretamente no código-fonte!
# ============================================================================

PORT=3000

# Segredo de Criptografia de Sessão / JWT
JWT_SECRET=substitua_por_um_segredo_forte_no_cofre_do_servidor

# Gateway de Pagamento (Stripe / Assinatura Mensal Recorrente)
CHAVE_PAGAMENTO=sk_live_configure_no_cofre_do_servidor
STRIPE_WEBHOOK_SECRET=whsec_configure_no_cofre_do_servidor
MONTHLY_PRICE_CENTS=2990
MONTHLY_CURRENCY=brl

# Configuração de E-mail Transacional (Recuperação de Senha e Cobrança Mensal)
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=nao-responda@yaniktranslator.com
SMTP_PASS=senha_smtp_no_cofre_do_servidor

# Alerta no Celular se o Servidor Cair (Telegram Bot / Webhook / Pushover / ntfy.sh)
MOBILE_ALERT_WEBHOOK_URL=https://ntfy.sh/yanik-translator-alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
